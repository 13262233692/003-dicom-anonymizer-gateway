{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@common/*": ["src/common/*"],
      "@dicom/*": ["src/dicom/*"],
      "@protocol/*": ["src/protocol/*"],
      "@anonymization/*": ["src/anonymization/*"],
      "@routing/*": ["src/routing/*"],
      "@audit/*": ["src/audit/*"],
      "@redis/*": ["src/redis/*"],
      "@hl7/*": ["src/hl7/*"]
    }
  }
}
